---
layout: base.njk
permalink: "/insights/{{ cluster }}/{{ page.fileSlug }}/"
---

<article class="pillar">

  {# === Breadcrumbs — spans full width === #}
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      <li><a href="/insights/">Insights</a></li>
      <li><a href="/insights/{{ cluster }}/">{{ cluster | replace("-", " ") | title }}</a></li>
      <li aria-current="page">{{ title }}</li>
    </ol>
  </nav>

  {# === TOC sidebar (sticky on desktop, above content on mobile) === #}
  {% if toc and toc.length %}
  <nav class="toc" aria-label="Table of contents">
    <h2>Contents</h2>
    <ol>
      {% for item in toc %}
        <li><a href="#{{ item.id }}">{{ item.text }}</a></li>
      {% endfor %}
    </ol>
  </nav>
  {% endif %}

  {# === Article header === #}
  <header class="pillar-header">
    <p class="eyebrow">{{ cluster | replace("-", " ") | title }}</p>
    <h1>{{ title }}</h1>
    {% if subtitle %}<p class="subtitle">{{ subtitle }}</p>{% endif %}
    <p class="meta">
      <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
      &nbsp;·&nbsp;{{ content | readingTime }} min read
    </p>
  </header>

  {# === Prose body === #}
  <div class="pillar-body">
    {{ content | safe }}
  </div>

  {# === Sibling articles in same cluster === #}
  {% set siblings = collections[cluster] | default([]) %}
  {% if siblings.length > 1 %}
  <section class="cluster-children">
    <h2>More in {{ cluster | replace("-", " ") | title }}</h2>
    <div class="cluster-grid">
      {% for item in siblings %}
        {% if item.url != page.url and loop.index0 < 6 %}
        <a href="{{ item.url }}" class="cluster-card">
          <span class="cluster-card-label">{{ item.data.cluster | replace("-", " ") | title }}</span>
          <span class="cluster-card-title">{{ item.data.title }}</span>
        </a>
        {% endif %}
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {# === FAQ accordion === #}
  {% if faqs %}
  <section class="faqs">
    <h2>Frequently asked questions</h2>
    {% for faq in faqs %}
    <details>
      <summary>{{ faq.q }}</summary>
      <div>{{ faq.a | safe }}</div>
    </details>
    {% endfor %}
  </section>
  {% endif %}

  {# === Parent pillar back-link === #}
  {% if parent_pillar and parent_pillar != slug %}
  <aside class="pillar-link">
    <p>Part of our complete guide:
      <a href="/insights/{{ cluster }}/{{ parent_pillar }}/">
        Read the full {{ cluster | replace("-", " ") }} guide →
      </a>
    </p>
  </aside>
  {% endif %}

</article>

{# === Structured data — Article === #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "{{ title | escape }}",
  "description": "{{ (description or angle) | escape }}",
  "datePublished": "{{ date | isoDate }}",
  "dateModified": "{{ (modified or date) | isoDate }}",
  "author": { "@type": "Organization", "name": "DesigXner", "url": "https://desigxner.com" },
  "publisher": {
    "@type": "Organization",
    "name": "DesigXner",
    "url": "https://desigxner.com",
    "logo": { "@type": "ImageObject", "url": "https://desigxner.com/images/logo.png" }
  },
  "mainEntityOfPage": "https://desigxner.com{{ page.url }}"
}
</script>

{# === Structured data — BreadcrumbList === #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://desigxner.com/" },
    { "@type": "ListItem", "position": 2, "name": "Insights", "item": "https://desigxner.com/insights/" },
    { "@type": "ListItem", "position": 3, "name": "{{ cluster | replace('-', ' ') | title }}", "item": "https://desigxner.com/insights/{{ cluster }}/" },
    { "@type": "ListItem", "position": 4, "name": "{{ title | escape }}", "item": "https://desigxner.com{{ page.url }}" }
  ]
}
</script>

{# === Structured data — FAQPage === #}
{% if faqs %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for faq in faqs %}
    {
      "@type": "Question",
      "name": "{{ faq.q | escape }}",
      "acceptedAnswer": { "@type": "Answer", "text": "{{ faq.a | striptags | escape }}" }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}
